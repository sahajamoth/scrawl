{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Scrawl",
  "scopeName": "source.scrawl",
  "patterns": [
    { "include": "#comment" },
    { "include": "#table-header" },
    { "include": "#key-value" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.hash.scrawl",
      "match": "#.*$"
    },
    "table-header": {
      "name": "keyword.other.scrawl",
      "match": "^\\s*(\\[d\\]|\\[\\[n\\]\\]|\\[\\[e\\]\\]|\\[\\[g\\]\\])\\s*$"
    },
    "key-value": {
      "patterns": [
        {
          "match": "^\\s*([\\w-]+)\\s*=\\s*(\"[^\"]*\")",
          "captures": {
            "1": { "name": "variable.other.scrawl" },
            "2": { "name": "string.quoted.double.scrawl" }
          }
        },
        {
          "match": "^\\s*([\\w-]+)\\s*=\\s*(true|false|[0-9]+(?:\\.[0-9]+)?)",
          "captures": {
            "1": { "name": "variable.other.scrawl" },
            "2": { "name": "constant.numeric.scrawl" }
          }
        },
        {
          "match": "^\\s*([\\w-]+)\\s*=",
          "captures": {
            "1": { "name": "variable.other.scrawl" }
          }
        }
      ]
    }
  }
}
