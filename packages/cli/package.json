{
  "name": "scrawl-cli",
  "version": "0.7.0",
  "description": "CLI for scrawl diagrams. Pipe text in, get SVG out. Deterministic output. 5 hand-drawn style presets.",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/sahajamoth/scrawl", "directory": "packages/cli" },
  "keywords": ["cli", "diagrams", "svg", "hand-drawn", "scrawl"],
  "files": ["dist"],
  "type": "module",
  "bin": {
    "scrawl": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "scrawl-core": "workspace:*",
    "@resvg/resvg-js": "^2.6.2"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "@types/node": "^22.10.7"
  }
}
