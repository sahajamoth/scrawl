{
  "name": "@scrawl/core",
  "version": "0.1.0",
  "description": "Parse and render scrawl diagrams to hand-drawn SVGs. Zero-coordinate, line-oriented diagram format — 57% fewer tokens than Mermaid.",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/sahajamoth/scrawl", "directory": "packages/core" },
  "keywords": ["diagrams", "svg", "hand-drawn", "rough-js", "mermaid-alternative", "diagram-as-code", "llm"],
  "files": ["dist"],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "roughjs": "^4.6.6",
    "@xmldom/xmldom": "^0.9.8"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "vitest": "^2.1.8",
    "typescript": "^5.7.3",
    "@types/node": "^22.10.7"
  }
}
