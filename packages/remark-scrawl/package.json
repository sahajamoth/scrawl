{
  "name": "remark-scrawl",
  "version": "0.1.0",
  "description": "Remark plugin to render scrawl diagram code blocks as hand-drawn SVGs in Markdown and MDX.",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/sahajamoth/scrawl", "directory": "packages/remark-scrawl" },
  "keywords": ["remark", "markdown", "diagrams", "svg", "hand-drawn", "scrawl", "unified"],
  "files": ["dist"],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "scrawl-core": "workspace:*",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.10.7",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "remark-parse": "^11.0.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "unified": "^11.0.0",
    "vitest": "^2.1.8"
  }
}
